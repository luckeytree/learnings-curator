#!/usr/bin/env bash
# Turn the weekly learnings sweep on, off, or check it. One schedule per machine: each machine
# can only read its own memory folders, so run this on every machine you work on.
#
#   bin/schedule-sweep            turn it on (Fridays 3pm local; change with SWEEP_WEEKDAY=0-6
#                                 where 0 is Sunday, and SWEEP_HOUR=0-23)
#   bin/schedule-sweep --status   is it on, and where's the log
#   bin/schedule-sweep --remove   turn it off
#   bin/schedule-sweep --print    show what it would install, change nothing
#
# Re-run it if you move the clone: the schedule points at this folder by full path.
# macOS uses launchd (a sweep missed while asleep runs on wake). Linux uses cron.
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
REPO="$(pwd)"
DAY="${SWEEP_WEEKDAY:-5}"; HOUR="${SWEEP_HOUR:-15}"
LABEL="com.learnings-curator.sweep"
DAYS=(Sundays Mondays Tuesdays Wednesdays Thursdays Fridays Saturdays)
TAG="# learnings-curator sweep"

# The last "== sweep <date>" header in the log is the last time a sweep actually started.
last_run() {
  local l; l=$(grep '^== sweep ' "$LOG" 2>/dev/null | tail -1 | sed -e 's/^== sweep //' -e 's/ ==$//')
  echo "last ran: ${l:-never}"
  echo "log: $LOG"
}
limits() {
  cat <<'TXT'

How this runs: on this computer's own scheduler, not in the cloud.
  - Your machine must be on and awake at that time. Pick a time you're usually working.
  - Asleep or lid closed: macOS runs it when the machine wakes; Linux skips it.
  - Shut down: that week is skipped.
  - It uses your Claude login and usage. Expired login or no usage left = a failed run.
  - It sees only this machine's memory folders. Set it up on each machine you use.
  - Check it's actually running with: bin/schedule-sweep --status
TXT
}

case "$DAY" in [0-6]) ;; *) echo "SWEEP_WEEKDAY must be 0-6 (0 = Sunday)" >&2; exit 2;; esac
case "$HOUR" in [0-9]|1[0-9]|2[0-3]) ;; *) echo "SWEEP_HOUR must be 0-23" >&2; exit 2;; esac

if [ "$(uname)" = "Darwin" ]; then
  PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
  LOG="$HOME/Library/Logs/learnings-curator-sweep.log"
  case "${1:-}" in
    --status)
      if [ -f "$PLIST" ]; then echo "on  ($PLIST)"; else echo "off"; fi
      last_run; exit 0;;
    --remove)
      launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
      rm -f "$PLIST"; echo "off. Run /sync-learnings by hand whenever you like."; exit 0;;
  esac
  CLAUDE_BIN="$(command -v claude)" || { echo "claude not found on PATH" >&2; exit 1; }
  [ "${1:-}" = "--print" ] && PLIST=/dev/stdout
  [ "$PLIST" != /dev/stdout ] && mkdir -p "$(dirname "$PLIST")" "$(dirname "$LOG")"
  cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array><string>$REPO/bin/run-sweep</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$PATH</string>
    <key>CLAUDE_BIN</key><string>$CLAUDE_BIN</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>$DAY</integer><key>Hour</key><integer>$HOUR</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
EOF
  [ "$PLIST" = /dev/stdout ] && exit 0
  plutil -lint "$PLIST" >/dev/null || { echo "plist failed lint: $PLIST" >&2; exit 1; }
  launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST" || { echo "launchctl couldn't load it" >&2; exit 1; }
  printf 'on: weekly, %s at %02d:00. Log: %s\n' "${DAYS[$DAY]}" "$HOUR" "$LOG"
else
  LOG="$HOME/.cache/learnings-curator/sweep.log"
  case "${1:-}" in
    --status)
      if crontab -l 2>/dev/null | grep -qF "$TAG"; then echo "on"; else echo "off"; fi
      last_run; exit 0;;
    --remove)
      crontab -l 2>/dev/null | grep -vF "$TAG" | crontab -
      echo "off. Run /sync-learnings by hand whenever you like."; exit 0;;
  esac
  CLAUDE_BIN="$(command -v claude)" || { echo "claude not found on PATH" >&2; exit 1; }
  mkdir -p "$(dirname "$LOG")"
  line="0 $HOUR * * $DAY PATH='$PATH' CLAUDE_BIN='$CLAUDE_BIN' '$REPO/bin/run-sweep' >> '$LOG' 2>&1 $TAG"
  [ "${1:-}" = "--print" ] && { echo "$line"; exit 0; }
  { crontab -l 2>/dev/null | grep -vF "$TAG"; echo "$line"; } | crontab -
  printf 'on: weekly, %s at %02d:00. Log: %s\n' "${DAYS[$DAY]}" "$HOUR" "$LOG"
fi
limits
echo
echo "To run one now: bin/run-sweep. You can still run /sync-learnings any time."
